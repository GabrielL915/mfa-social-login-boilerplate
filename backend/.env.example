PORT=3000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
# Testando social pelo celular/tunel: BACKEND_URL=https://SEU-TUNEL (o Vite faz proxy de /auth)

JWT_SECRET=change-me-access
JWT_EXPIRES=15m
MFA_TOKEN_SECRET=change-me-mfa-temp
MFA_ISSUER=MeuApp

GOOGLE_CLIENT_ID=
